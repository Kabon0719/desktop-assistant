{
  "version": "1.0",
  "export_type": "desktop_assistant_settings",
  "dialogue_prompt": "嘿嘿，是有什麼事情要吩咐洒家嗎？",
  "animation_groups": {
    "idle": [
      "train_dummy",
      "train_meditate"
    ],
    "asking": [
      "ask_fist",
      "ask_pray"
    ],
    "executing": [
      "act_punch"
    ]
  },
  "pomodoro": {
    "duration_minutes": 20,
    "sound_file": ""
  },
  "window": {
    "idle_size": [
      260,
      260
    ],
    "focus_size": [
      330,
      330
    ],
    "fps": 12,
    "stay_on_top": true
  },
  "behavior": {
    "scale_in_place": true,
    "idle_switch_interval_sec": 20,
    "asking_switch_interval_sec": 15,
    "approach_duration_ms": 450,
    "return_duration_ms": 450
  }
}